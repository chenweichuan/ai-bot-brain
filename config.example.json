{
  "debug": false,
  "owner_name": "User",
  "bot_name": "Bot",
  "bot_alias": "",
  "bot_os_user": "bot",
  "bot_os_workspace": "/opt/bot",
  "os_display": ":0",
  "storage_base_path": "/opt/www/storage",
  "storage_base_url": "https://your-domain.com/storage",
  "tmp_base_path": "/tmp",
  "models_base_path": "/opt/www/models",
  "short_link_base_url": "https://your-domain.com/l",
  "redis": {
    "host": "localhost",
    "port": 6379,
    "db": 0,
    "password": ""
  },
  "chat_model": "doubao-seed-2.0-lite",
  "agent_model": "doubao-seed-2.0-lite",
  "memory_model": "doubao-seed-2.0-lite",
  "image_model": "doubao-seedream-5.0-lite",
  "max_context_text_units": 100000,
  "max_context_messages": 100,
  "max_context_model_rounds": 30,
  "max_impression_text_units_per_set": 10000,
  "max_think_rounds": 100,
  "auto_scheduler_interval": 3600,
  "rate_limit_image": 5,
  "model_providers": [
    {
      "name": "volcengine",
      "api_base": "https://ark.cn-beijing.volces.com/api/v3",
      "api_key": "your_volcengine_api_key"
    },
    {
      "name": "deepseek",
      "api_base": "https://api.deepseek.com",
      "api_key": "your_deepseek_api_key"
    },
    {
      "name": "zhipu",
      "api_base": "https://open.bigmodel.cn/api/paas/v4",
      "api_key": "your_zhipu_api_key"
    }
  ],
  "model_routes": [
    {
      "prefixes": ["doubao-"],
      "provider": "volcengine",
      "format": "responses"
    },
    {
      "prefixes": ["deepseek-"],
      "provider": "deepseek",
      "format": "completions"
    },
    {
      "prefixes": ["glm-"],
      "provider": "zhipu",
      "format": "completions",
      "vision_fallback": {
        "glm-4.7": "glm-4.6v",
        "glm-5.2": "glm-5v-turbo"
      }
    }
  ],
  "content_moderation": {
    "enabled": true,
    "provider": "aliyun",
    "fallback_action": "allow",
    "reject_log_only": false,
    "aliyun": {
      "access_key_id": "your_aliyun_access_key_id",
      "access_key_secret": "your_aliyun_access_key_secret",
      "region_id": "cn-beijing",
      "endpoint": "green-cip.cn-beijing.aliyuncs.com",
      "backup_endpoint": "green-cip.cn-shanghai.aliyuncs.com"
    }
  },
  "tencent_search_secret_id": "your_tencent_search_secret_id",
  "tencent_search_secret_key": "your_tencent_search_secret_key",
  "volc_search_api_key": "your_volc_search_api_key",
  "proxy_pool_url": "http://127.0.0.1:5010/get/",
  "chromium_path": "/usr/bin/chromium-browser"
}
